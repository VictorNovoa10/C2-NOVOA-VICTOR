generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Evento {
  id            Int             @id @default(autoincrement())
  titulo        String
  fechaHora     DateTime
  lugar         String
  imagen        String
  valor         Int             @default(0)
  inscripciones Inscripcion[]

  @@index([fechaHora])
}

model Inscripcion {
  id       Int    @id @default(autoincrement())
  nombre   String
  email    String
  eventoId Int

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
}